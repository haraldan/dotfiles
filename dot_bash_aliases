# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'

# eza in place of ls where installed. la and l are redefined too, since they
# build on the ls alias and eza doesn't take ls's -C
if command -v eza >/dev/null 2>&1; then
    alias ls='eza -l --group-directories-first --icons=auto'
    alias ll='ls -a'
    alias la='eza -a --group-directories-first'
fi

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

alias vim="nvim"
alias vi="nvim"
alias v="nvim"
alias lg=lazygit
alias ..="cd .."

# Activate a venv from ~/.virtualenvs
workon() { source ~/.virtualenvs/"$1"/bin/activate; }
complete -W '$(ls ~/.virtualenvs 2>/dev/null)' workon

# cd falls back to zoxide when the argument isn't a directory (like Omarchy's
# zd). Goes through ch from .bashrc so the per-directory HISTFILE still switches
if command -v zoxide >/dev/null 2>&1 && declare -F ch >/dev/null; then
    zd() {
        if (( $# == 0 )) || [[ $1 == - || -d $1 ]]; then
            ch "$@"
        else
            local dir
            dir=$(zoxide query -- "$@") || { echo "Error: Directory not found"; return 1; }
            ch "$dir" && pwd
        fi
    }
    alias cd=zd
fi
