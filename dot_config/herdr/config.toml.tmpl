onboarding = false

[terminal]
new_cwd = "follow"

[ui]
mouse_capture = true
copy_on_select = true
prompt_new_tab_name = false
tab_bar_position = "bottom"
tab_bar_right = [
  { type = "zoom" },
  { type = "datetime", format = "%Y-%m-%d" },
  { type = "datetime", format = "%H:%M" },
  { type = "hostname" },
]
tab_bar_right_separator = " | "
pane_outer_borders = false
pane_gaps = false
status_indicators = "symbols"

[ui.sidebar.spaces]
rows = [["state_icon", "workspace"]]

[keys]
prefix = "ctrl+space"

{{ if eq .chezmoi.os "windows" -}}
# Native focus bindings: a script per keypress is too slow on Windows, so no wraparound.
focus_pane_left = "alt+h"
focus_pane_down = "alt+j"
focus_pane_up = "alt+k"
focus_pane_right = "alt+l"
{{- else -}}
# Alt+h/j/k/l are Vim-aware custom commands with wraparound, defined below.
focus_pane_left = ""
focus_pane_down = ""
focus_pane_up = ""
focus_pane_right = ""
{{- end }}
# prefix+j/k switch workspaces and prefix+h/l switch agents instead of panes.
workspace_picker = ["prefix+w", "alt+w"]
next_workspace = "prefix+j"
previous_workspace = "prefix+k"
previous_agent = "prefix+h"
next_agent = "prefix+l"
{{ if eq .chezmoi.os "windows" -}}
resize_pane_up = "alt+up"
resize_pane_down = "alt+down"
resize_pane_left = "alt+left"
resize_pane_right = "alt+right"
{{- else -}}
# Alt+arrows are Vim-aware custom commands, defined below.
resize_pane_up = ""
resize_pane_down = ""
resize_pane_left = ""
resize_pane_right = ""
{{- end }}
zoom = ["prefix+z", "alt+z"]

split_horizontal = ["prefix+minus", "alt+="]
split_vertical = ['prefix+\', "alt+/"]

{{ if eq .chezmoi.os "windows" -}}
new_tab = "alt+shift+c"
{{- else -}}
# New tabs are custom commands (below) so they open after the current tab.
new_tab = ""
{{- end }}
next_tab = "alt+n"
previous_tab = "alt+p"
move_tab_previous = "prefix+p"
move_tab_next = "prefix+n"
switch_tab = "prefix+1..9"

# Keep Herdr's native vi copy mode; leave Ctrl+Q available to pane apps.
copy_mode = ["prefix+[", "alt+q"]

# Free prefix+g for lazygit; retain access to Herdr's picker.
goto = "prefix+f"

# Navigate mode: j/k switch workspaces; Alt+h/j/k/l move between panes as elsewhere.
navigate_workspace_down = ["down", "j"]
navigate_workspace_up = ["up", "k"]
navigate_pane_left = "alt+h"
navigate_pane_down = "alt+j"
navigate_pane_up = "alt+k"
navigate_pane_right = "alt+l"
{{- $pane := "$HERDR_ACTIVE_PANE_ID" }}
{{- $home := "$HOME" }}
{{- if eq .chezmoi.os "windows" }}
{{-   $pane = "%HERDR_ACTIVE_PANE_ID%" }}
{{-   $home = "%USERPROFILE%" }}
{{- else }}
{{-   range $nav := list (list "h" "left") (list "j" "down") (list "k" "up") (list "l" "right") }}

[[keys.command]]
key = "alt+{{ index $nav 0 }}"
type = "shell"
command = '~/.config/herdr/navigate.sh {{ index $nav 1 }} alt+{{ index $nav 0 }}'
description = "Navigate {{ index $nav 1 }} (Vim-aware)"
{{-   end }}
{{-   range $dir := list "up" "down" "left" "right" }}

[[keys.command]]
key = "alt+{{ $dir }}"
type = "shell"
command = '~/.config/herdr/resize.sh {{ $dir }} alt+{{ $dir }}'
description = "Resize {{ $dir }} (Vim-aware)"
{{-   end }}
{{- end }}

{{- range $nav := list (list "h" "left") (list "j" "down") (list "k" "up") (list "l" "right") }}

[[keys.command]]
key = "alt+shift+{{ index $nav 0 }}"
type = "shell"
command = "herdr pane swap --pane {{ $pane }} --direction {{ index $nav 1 }}"
description = "Swap pane {{ index $nav 1 }}"
{{- end }}

{{- if ne .chezmoi.os "windows" }}

{{-   range $key := list "prefix+c" "alt+c" }}

[[keys.command]]
key = "{{ $key }}"
type = "shell"
command = '~/.config/herdr/new_tab.py home'
description = "New tab after current, in home, without moving focus"
{{-   end }}

[[keys.command]]
key = "alt+shift+c"
type = "shell"
command = '~/.config/herdr/new_tab.py cwd'
description = "New tab after current, in current directory, without moving focus"
{{- else }}
{{-   range $key := list "prefix+c" "alt+c" }}

[[keys.command]]
key = "{{ $key }}"
type = "shell"
command = "herdr tab create --cwd {{ $home }} --focus"
description = "New tab in home"
{{-   end }}
{{- end }}

[[keys.command]]
key = "alt+minus"
type = "shell"
command = "herdr pane split --pane {{ $pane }} --direction down --ratio 0.8 --focus"
description = "Split bottom pane at 20%"

[[keys.command]]
key = "prefix+g"
type = "popup"
command = "lazygit"
description = "lazygit"
width = "90%"
height = "90%"

[[keys.command]]
key = "alt+g"
type = "popup"
command = "lazygit"
description = "lazygit"
width = "90%"
height = "90%"

[theme]
name = "{{ if eq .chezmoi.os "windows" }}vesper{{ else }}dracula{{ end }}"
auto_switch = false

[theme.custom]
# Muted nord-style status colors for agent indicators
red = "#bf616a"
yellow = "#ebcb8b"
green = "#a3be8c"
teal = "#8fbcbb"

[ui.toast]
delivery = "herdr"

[ui.sound]
enabled = false
