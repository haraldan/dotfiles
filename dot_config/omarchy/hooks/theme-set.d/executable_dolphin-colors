#!/bin/bash

# Omarchy themes Qt apps only through the gtk3 platform theme, which gives plain
# Adwaita light/dark. Dolphin reads a KDE color scheme through
# KColorSchemeManager, which ignores GTK colors and, with no scheme chosen, falls
# back to BreezeLight or BreezeDark following the system light/dark preference
# (NightMan can flip it independently of the theme). Schemes in ~/.local/share
# override the built-in ones by file name, so write both from the theme's
# colors.toml: the theme's own colors for its mode, neutral Adwaita-like ones for
# the other, and the theme's accent as highlight in both.

colors_toml=$HOME/.local/state/omarchy/current/theme/colors.toml
scheme_dir=$HOME/.local/share/color-schemes

[[ -r $colors_toml ]] || exit 0

declare -A c
while IFS='=' read -r key value; do
  key=${key//[[:space:]]/}
  value=$(sed -E 's/^[[:space:]]*"?//; s/"?[[:space:]]*$//' <<<"$value")
  [[ $value =~ ^#[0-9a-fA-F]{6}$ || $key == mode ]] && c[$key]=$value
done < <(grep -E '^[a-z_]+[[:space:]]*=' "$colors_toml")

theme_mode=${c[mode]:-dark}

# KDE color schemes take "r,g,b"; arguments are theme keys or literal hex,
# first one that resolves wins
rgb() {
  local hex
  for k in "$@"; do
    hex=${c[$k]:-$k}
    [[ $hex =~ ^#[0-9a-fA-F]{6}$ ]] && break
  done
  hex=${hex#\#}
  printf '%d,%d,%d' 0x${hex:0:2} 0x${hex:2:2} 0x${hex:4:2}
}

# Black or white text, whichever reads better on the given color
contrast() {
  local r g b
  IFS=, read -r r g b <<<"$(rgb "$@")"
  (( (299 * r + 587 * g + 114 * b) / 1000 > 140 )) && echo '#1e1e1e' || echo '#ffffff'
}

# One [Colors:*] group: background, alternate background, foreground
group() {
  cat <<EOF
[Colors:$1]
BackgroundNormal=$(rgb $2)
BackgroundAlternate=$(rgb $3)
ForegroundNormal=$(rgb $4)
ForegroundInactive=$(rgb $inactive)
ForegroundActive=$(rgb accent $4)
ForegroundLink=$(rgb accent blue)
ForegroundVisited=$(rgb magenta accent)
ForegroundNegative=$(rgb red $4)
ForegroundNeutral=$(rgb yellow $4)
ForegroundPositive=$(rgb green $4)
DecorationFocus=$(rgb accent $4)
DecorationHover=$(rgb accent $4)

EOF
}

# Write <id>.colors named <name> from the role variables set by the caller
write_scheme() {
  local accent_text
  accent_text=$(contrast accent)
  {
    printf '[General]\nName=%s\nColorScheme=%s\n\n' "$2" "$1"
    group Window "$window" "$alt" "$fg"
    group View "$view" "$alt" "$fg"
    group Header "$header" "$header" "$fg"
    group Button "$button" "$button" "$fg"
    group Selection "accent $fg" "accent $fg" "$accent_text"
    group Tooltip "$header" "$header" "$fg"
    group Complementary "$header" "$header" "$fg"
    cat <<EOF
[WM]
activeBackground=$(rgb $header)
activeForeground=$(rgb $fg)
inactiveBackground=$(rgb $header)
inactiveForeground=$(rgb $inactive)
EOF
  } >"$scheme_dir/$1.colors"
}

themed() {
  window=background view=background alt=dark_background header=dark_background
  button=lighter_background fg=foreground inactive="dark_foreground muted"
}

mkdir -p "$scheme_dir"

if [[ $theme_mode == light ]]; then themed; else
  window='#f6f5f4' view='#ffffff' alt='#f6f5f4' header='#ebebeb'
  button='#ffffff' fg='#2e3436' inactive='#77767b'
fi
write_scheme BreezeLight "Breeze Light (Omarchy)"

if [[ $theme_mode == dark ]]; then themed; else
  window='#353535' view='#2d2d2d' alt='#353535' header='#303030'
  button='#3a3a3a' fg='#eeeeec' inactive='#9a9996'
fi
write_scheme BreezeDark "Breeze Dark (Omarchy)"

# KColorSchemeManager drops its scheme when the light/dark preference changes
# while Dolphin is running, leaving the GTK palette (Adwaita blue highlight)
# until Dolphin is reopened. Give GTK the same accent so that fallback matches.
mkdir -p "$HOME/.config/gtk-3.0"
cat >"$HOME/.config/gtk-3.0/gtk.css" <<EOF
/* Generated by the dolphin-colors theme-set hook; overwritten on theme change */
@define-color theme_selected_bg_color ${c[accent]};
@define-color theme_selected_fg_color $(contrast accent);
*:selected, *:selected:focus { background-color: ${c[accent]}; color: $(contrast accent); }
EOF
