{
  "bar": {
    "layout": {
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "weekStartDay": "monday"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "io.github.thetrueferret.decent-workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [
            "easyeffects"
          ],
          "hidden": []
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "{{ if eq .chezmoi.hostname "Think" }}daniel.bluetooth{{ else }}omarchy.bluetooth{{ end }}"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "codefriendly.nightman"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "tray": []
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 600,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "daniel.lock"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "daniel.lock"
  ]
}
