#!/usr/bin/env bash

# herdr-open-tab: open a directory as a new tab in the running herdr session and
# bring its terminal window to the front. Starts herdr in a new terminal when no
# client is attached. Invoked from the Dolphin service menu
# (~/.local/share/kio/servicemenus/herdr-open-tab.desktop); Linux counterpart of
# ~/.config/herdr/open-tab.ps1.

dir=${1:-$PWD}

# A Herdr window runs a bare `herdr` client; the server and CLI calls carry
# arguments.
client_pid() {
    local pid args
    for pid in $(pgrep -u "$USER" -x herdr); do
        args=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null) || continue
        [[ ${args% } =~ ^[^\ ]*herdr$ ]] && { echo "$pid"; return 0; }
    done
    return 1
}

wait_for() {
    local i
    for (( i = 0; i < 50; i++ )); do
        "$@" >/dev/null && return 0
        sleep 0.2
    done
    return 1
}

if ! client_pid >/dev/null; then
    # Starting herdr restores the saved session and ignores the terminal's cwd,
    # so the tab is created once the client is up.
    setsid uwsm-app -- xdg-terminal-exec --dir="$dir" herdr >/dev/null 2>&1 &
    wait_for client_pid || exit 1
    wait_for herdr workspace list || exit 1
fi

herdr tab create --cwd "$dir" --focus >/dev/null || exit 1

# Focus the terminal window hosting the client: walk up from the client to the
# first ancestor that owns a Hyprland window.
windows=$(hyprctl clients -j)
pid=$(client_pid)
while [[ -n $pid && $pid -gt 1 ]]; do
    address=$(jq -r --argjson pid "$pid" 'first(.[] | select(.pid == $pid) | .address) // empty' <<<"$windows")
    if [[ -n $address ]]; then
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null
        break
    fi
    pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
done
