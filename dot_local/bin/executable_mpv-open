#!/usr/bin/env python3
"""Open files in the running mpv, replacing what's playing, or start mpv.

Talks to the socket set by ~/.config/mpv/scripts/single-instance.lua. Takes
mpv's own arguments; options only apply when a new mpv has to start.
"""

import json
import os
import socket
import subprocess
import sys

SOCKET = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "mpv.sock")


def files(args):
    after_dashes = False
    for arg in args:
        if arg == "--" and not after_dashes:
            after_dashes = True
        elif after_dashes or not arg.startswith("-"):
            # The running mpv has its own working directory
            yield arg if "://" in arg else os.path.abspath(arg)


def load_in_running(paths):
    commands = [["loadfile", paths[0], "replace"]]
    commands += [["loadfile", path, "append"] for path in paths[1:]]
    with socket.socket(socket.AF_UNIX) as sock:
        sock.connect(SOCKET)
        for command in commands:
            sock.sendall(json.dumps({"command": command}).encode() + b"\n")


def main():
    paths = list(files(sys.argv[1:]))
    if paths:
        try:
            load_in_running(paths)
        except OSError:
            pass  # No mpv running (or a stale socket): start one
        else:
            try:
                subprocess.run(
                    ["hyprctl", "dispatch", 'hl.dsp.focus({ window = "class:^mpv$" })'],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            except OSError:
                pass  # Not on Hyprland
            return
    os.execvp("mpv", ["mpv", *sys.argv[1:]])


if __name__ == "__main__":
    main()
