#!/usr/bin/env bash

# terminal-cwd: print the working directory of the active terminal window.
# Like omarchy-cmd-terminal-cwd, but asks herdr for its focused pane when the
# terminal runs herdr (Omarchy's helper only sees the herdr client, not the
# shell inside it, and falls back to $HOME).

terminal_pid=$(hyprctl activewindow -j | jq -r '.pid')

if pgrep -P "$terminal_pid" -x herdr >/dev/null; then
    cwd=$(herdr pane list 2>/dev/null |
        jq -r '.result.panes[] | select(.focused) | .foreground_cwd // .cwd' | head -n1)
    if [[ -d $cwd ]]; then
        echo "$cwd"
        exit
    fi
fi

exec omarchy-cmd-terminal-cwd
